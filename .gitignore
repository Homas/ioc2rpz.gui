# Dependencies
node_modules/
vendor/

# PHP test tooling
.phpunit.cache/
phpunit.xml

# Build output (generated by `npm run build`)
www/dist/
dist/

# SQLite database (runtime data)
www/io2cfg/*.sqlite
www/io2cfg/*.sqlite-wal
www/io2cfg/*.sqlite-shm

# Editor backups. www/js/io2.js.bak and .bak2 were tracked and served over HTTP
# from the document root; do not let them back in.
*.bak
*.bak[0-9]
*.orig

# Vendored third-party archives. FontAwesome is downloaded during the Docker build
# (see Dockerfile) and bootstrap-vue is no longer used after the Vue 3 migration.
# pkg/openresty-*.deb is deliberately NOT ignored: io2install_rpidns.php fetches it
# from raw.githubusercontent.com, so it has to stay in the repository.
pkg/*.zip
pkg/fontawesome-free-*-web/

# Local developer workflow scripts. These carry personal paths, internal host
# addresses and deployment targets, so they are kept out of the public repository.
upload_docker.sh
upload_local.sh
git_commit_*.sh
install_void.txt

# Internal security remediation tracker. Open findings live here while they are
# being worked; publishing unfixed issues in a public repo is not helpful.
# Reviewed items graduate to TODO.md.
security_fix_tasks.md

# macOS
.DS_Store

# Editor / IDE
.kiro/
.vscode/
.idea/
*.swp
*.swo
*~

# Environment files
.env
.env.*

# Logs
*.log
